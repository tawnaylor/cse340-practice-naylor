<%- include('../partials/header', { currentPage: 'faculty' }) %>

<main class="faculty-detail">
    <h1><%= member.name %></h1>
    <p class="faculty-meta"><%= member.title %> &bull; <%= member.department %></p>

    <dl>
        <dt>Title</dt>
        <dd><%= member.title %></dd>

        <dt>Department</dt>
        <dd><%= member.department %></dd>

        <dt>Office</dt>
        <dd><%= member.office %></dd>

        <dt>Phone</dt>
        <dd><%= member.phone %></dd>

        <dt>Email</dt>
        <dd><a href="mailto:<%= member.email %>"><%= member.email %></a></dd>
    </dl>

    <p><a href="/faculty">&larr; Back to Faculty Directory</a></p>
</main>

<%- include('../partials/footer') %>

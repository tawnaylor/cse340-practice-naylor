<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/catalog.css">
    <% if (NODE_ENV.includes('dev')) { %>
        <script>
            const host = window.location.hostname;
            const currentPort = window.location.port;
            const wsPort = currentPort ? (parseInt(currentPort, 10) + 1) : 3001;
            const ws = new WebSocket(`ws://${host}:${wsPort}`);
            ws.onclose = () => {
                setTimeout(() => location.reload(), 2000);
            };
        </script>
    <% } %>
</head>
<body class="<%= bodyClass %>">
    <header>
        <%- greeting %>
        <nav aria-label="Main navigation">
            <ul>
                <li><a href="/"<% if (currentPage === 'home') { %> aria-current="page"<% } %>>Home</a></li>
                <li><a href="/about"<% if (currentPage === 'about') { %> aria-current="page"<% } %>>About</a></li>
                <li><a href="/catalog"<% if (currentPage === 'catalog') { %> aria-current="page"<% } %>>Course Catalog</a></li>
                <li><a href="/demo"<% if (currentPage === 'demo') { %> aria-current="page"<% } %>>Middleware Demo</a></li>
            </ul>
        </nav>
    </header>